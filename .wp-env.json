{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#7.1.3",
	"phpVersion": "8.1",
	"port": 8888,
	"testsEnvironment": false,
	"mappings": {
		"wp-content/plugins/quickpostr": "."
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false
	},
	"lifecycleScripts": {
		"afterStart": "npx --no -- wp-env run cli wp plugin activate quickpostr"
	}
}

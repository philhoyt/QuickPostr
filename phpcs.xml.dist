<?xml version="1.0"?>
<ruleset name="QuickPostr">
    <description>QuickPostr PHP coding standards — WordPress ruleset.</description>

    <!-- What to scan -->
    <file>quickpostr.php</file>
    <file>uninstall.php</file>
    <file>includes/</file>
    <file>src/blocks/</file>
    <file>tests/</file>

    <!-- Ignore build output and third-party code -->
    <exclude-pattern>build/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>

    <!-- Show sniff codes in reports -->
    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <!-- WordPress ruleset -->
    <rule ref="WordPress">
        <!-- Allow short array syntax [] — modern PHP standard -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- Minimum PHP version -->
    <config name="testVersion" value="8.1-"/>

    <!-- Minimum WordPress version -->
    <config name="minimum_supported_wp_version" value="6.7"/>

    <!-- Test files follow PHPUnit conventions (descriptive method names,
         StudlyCaps filenames, a bootstrap that stubs ABSPATH) rather than
         WordPress file/doc naming. Scan them for real problems, not style. -->
    <rule ref="Squiz.Commenting.FunctionComment.Missing">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.MissingShort">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.VariableComment.Missing">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.FileComment.Missing">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>tests/*</exclude-pattern>
        <!--
        Block render.php templates are require'd inside a static closure by core
        (wp-includes/blocks.php: `$settings['render_callback'] = static function
        ( $attributes, $content, $block ) use ( $template_path ) { ... require
        $template_path; ... }`), so their variables are function-scoped, not
        globals. The sniff cannot see that and reports every local as an
        unprefixed global.
        -->
        <exclude-pattern>src/blocks/*/render.php</exclude-pattern>
    </rule>

    <!-- Enforce prefixing. Without an explicit prefix list this sniff cannot
         validate anything, so unprefixed globals would pass silently. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="quickpostr"/>
                <element value="QuickPostr"/>
                <element value="QUICKPOSTR"/>
            </property>
        </properties>
    </rule>

    <!-- Text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="quickpostr"/>
            </property>
        </properties>
    </rule>
</ruleset>

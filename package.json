{
  "name": "quickpostr",
  "version": "0.17.0",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "start": "webpack --watch --config webpack.config.js",
    "lint:js": "wp-scripts lint-js src/blocks",
    "lint:css": "wp-scripts lint-style src/blocks/**/*.css",
    "plugin-zip": "wp-scripts plugin-zip",
    "test:unit": "TZ=America/New_York wp-scripts test-unit-js",
    "pot": "wp i18n make-pot . languages/quickpostr.pot --domain=quickpostr --exclude=vendor,node_modules,build,tests,lib"
  },
  "files": [
    "build",
    "includes",
    "languages",
    "lib",
    "quickpostr.php",
    "uninstall.php",
    "readme.txt"
  ],
  "peerDependencies": {
    "@wordpress/blocks": "*",
    "@wordpress/element": "*",
    "@wordpress/i18n": "*"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@wordpress/eslint-plugin": "^25.2.0",
    "@wordpress/rich-text": "^7.46.0",
    "@wordpress/scripts": "^34.1.0",
    "@wordpress/stylelint-config": "^23.38.0",
    "ajv": "^8.20.0",
    "eslint": "^10.4.0"
  },
  "dependencies": {
    "micromodal": "^0.6.1"
  },
  "overrides": {
    "prettier": "npm:wp-prettier@^3.0.3"
  }
}

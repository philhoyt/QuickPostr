{
  "name": "quickpostr",
  "version": "0.20.0",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "start": "webpack --watch --config webpack.config.js",
    "lint:js": "wp-scripts lint-js src/blocks src/gallery-slider tests/e2e",
    "lint:css": "wp-scripts lint-style src/blocks/**/*.css",
    "plugin-zip": "wp-scripts plugin-zip",
    "test:unit": "TZ=America/New_York wp-scripts test-unit-jest",
    "test:e2e": "wp-scripts test-e2e",
    "test:e2e:debug": "wp-scripts test-e2e --debug",
    "test:php:integration": "wp-env run --config .wp-env.phpunit.json cli --env-cwd=wp-content/plugins/quickpostr vendor/bin/phpunit --testsuite integration --bootstrap tests/phpunit/integration-bootstrap.php",
    "wp-env": "wp-env",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:phpunit:start": "wp-env start --config .wp-env.phpunit.json",
    "env:phpunit:stop": "wp-env stop --config .wp-env.phpunit.json",
    "pot": "wp i18n make-pot . languages/quickpostr.pot --domain=quickpostr --exclude=vendor,node_modules,build,tests,lib"
  },
  "files": [
    "build",
    "includes",
    "languages",
    "lib",
    "patterns",
    "quickpostr.php",
    "uninstall.php",
    "readme.txt"
  ],
  "peerDependencies": {
    "@wordpress/a11y": "*",
    "@wordpress/blocks": "*",
    "@wordpress/element": "*",
    "@wordpress/i18n": "*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.64.0",
    "@types/react": "^18.3.28",
    "@wordpress/babel-preset-default": "^9.0.0",
    "@wordpress/e2e-test-utils-playwright": "^3.0.0",
    "@wordpress/env": "^11.17.0",
    "@wordpress/eslint-plugin": "^27.1.0",
    "@wordpress/jest-preset-default": "^14.2.0",
    "@wordpress/rich-text": "^7.46.0",
    "@wordpress/scripts": "^36.1.0",
    "@wordpress/stylelint-config": "^26.1.0",
    "ajv": "^8.20.0",
    "babel-jest": "^30.5.2",
    "eslint": "^10.4.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2"
  },
  "dependencies": {
    "micromodal": "^0.6.1"
  },
  "overrides": {
    "prettier": "npm:wp-prettier@^3.0.3"
  }
}
